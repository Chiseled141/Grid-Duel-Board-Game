<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>deckduel</groupId>
  <artifactId>deck-duel</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Deck Duel</name>
  <description>Networked two-player Deck Duel with authoritative Java server, Swing client and SQLite persistence.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- 21 is the long-term-support line that still runs on the Java 17 target. -->
    <javafx.version>21.0.5</javafx.version>
    <!-- Stamped into deckduel/version.properties; release builds may override it. -->
    <deckduel.version>${project.version}</deckduel.version>
    <!-- The release channel (docs/updates.md). Empty: no release channel is configured. -->
    <deckduel.update.url></deckduel.update.url>
    <deckduel.update.publicKey></deckduel.update.publicKey>
    <!-- The production game server (docs/deployment.md). Empty: no production server packaged. -->
    <deckduel.server.host></deckduel.server.host>
    <deckduel.server.port></deckduel.server.port>
  </properties>

  <dependencies>
    <!-- Allowed runtime dependencies: the SQLite JDBC driver and OpenJFX (AGENTS.md); JUnit 5 for tests. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
    <!-- JavaFX draws the match table in its own window; javafx-swing converts the
         shared Java2D card sprites. OpenJFX selects this machine's native classifier automatically. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>deck-duel</finalName>
    <resources>
      <!-- Art and audio are copied untouched; filtering would corrupt the binaries. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Only the version stamp shown on the startup screen and in Settings is filtered. -->
      <resource>
        <directory>src/main/filtered-resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- TestPositions is a package-private core test fixture, not a test
               class; its name matches surefire's default Test* include pattern,
               and a stale copy of its class file on the classpath makes `mvn test`
               (without clean) fail with a wrong-name error. -->
          <excludes>
            <exclude>**/TestPositions.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <!-- deck-duel-launcher.jar: the launcher and updater helper, JDK classes only, started as a
             separate process so the game's own files are never replaced while they are in use. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>launcher</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>launcher</classifier>
              <includes>
                <include>deckduel/launcher/**</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>deckduel.launcher.LauncherMain</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <!-- Runs first, on the unshaded classes, so JavaFX never enters it.
                 deck-duel-server.jar: the headless server and its operator tools for Linux (any CPU).
                 No JavaFX, Swing client, art or audio; SQLite brings its own native libraries,
                 including Linux aarch64. -->
            <id>server</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>server</shadedClassifierName>
              <outputFile>${project.build.directory}/deck-duel-server.jar</outputFile>
              <artifactSet>
                <excludes>
                  <exclude>org.openjfx:*</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>deckduel:deck-duel</artifact>
                  <excludes>
                    <exclude>deckduel/Main*</exclude>
                    <exclude>deckduel/client/**</exclude>
                    <exclude>deckduel/release/**</exclude>
                    <exclude>deckduel/update.properties</exclude>
                    <exclude>deckduel/connection.properties</exclude>
                    <exclude>assets/**</exclude>
                    <exclude>audio/**</exclude>
                    <exclude>fonts/**</exclude>
                    <exclude>fx/**</exclude>
                    <exclude>config/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>deckduel.server.ServerMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>deckduel.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>

        </executions>
      </plugin>
    </plugins>
  </build>
</project>
